STEAM_API_KEY=your_steam_web_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional — map display names to SteamID64 (comma-separated)
# STEAM_NAME_ALIASES=VenkraCade=76561198019362735

# Optional — used locally; Render sets RENDER_EXTERNAL_URL automatically
# APP_URL=https://your-app.onrender.com
# FLASK_SECRET_KEY=change-me-in-production
